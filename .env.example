# Copy to .env for local runs (node --env-file=.env server.js). On hosts, add these as environment variables / secrets.

# --- AI (required for real feedback; without it the app runs in a labelled offline mode) ---
# Open-source models via Groq (free tier): https://console.groq.com
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional backup provider if the main one fails or rate-limits (any OpenAI-compatible API), e.g. Gemini:
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# --- Speech-to-text for Safari/Firefox (open-source Whisper). Reuses the Groq key above if empty. ---
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- Voices (optional; the browser voice is used without it) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MEERA=
ELEVENLABS_VOICE_COACH=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Accounts, saved reports, leaderboard (Postgres: Neon, Supabase, Replit, Render, ...) ---
DATABASE_URL=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# --- Sign-in providers (optional, all free; see SETUP.md section 4). Callback: https://YOUR-DOMAIN/auth/<provider>/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Set when your public address differs from what the host reports, e.g. https://clarityai.geekypmtausif.com
PUBLIC_URL=

# --- Contact page (WhatsApp behind a human check; the number never appears in the page or the repo) ---
# Digits with country code, e.g. 9198xxxxxxxx. Contact is turned off when empty.
CONTACT_WHATSAPP=
CONTACT_NAME=
# Optional stronger bot check (Cloudflare Turnstile, free): https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Misc ---
RATE_LIMIT=80
