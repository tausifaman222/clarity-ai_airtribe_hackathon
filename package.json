{
  "name": "clarity-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Clarity AI: practise speaking confidently. Voice, video and AI feedback on what you say, not your grammar.",
  "license": "MIT",
  "author": "Ashish & Tausif",
  "homepage": "https://clarityai.geekypmtausif.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tausifaman222/clarity-ai_airtribe_hackathon.git"
  },
  "keywords": [
    "ai",
    "speaking",
    "interview",
    "pitch",
    "coaching",
    "multi-agent",
    "mcp",
    "whisper",
    "mediapipe"
  ],
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test tests/*.test.js && playwright test",
    "test:unit": "node --test tests/*.test.js",
    "test:api": "playwright test --project=api",
    "test:browser": "playwright test --project=chromium",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "1.63.0"
  }
}
